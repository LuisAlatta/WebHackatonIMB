---
const criteria = [
  {
    code: '01',
    name: 'Innovación',
    desc: 'Originalidad de la solución propuesta. ¿La idea aporta algo genuinamente nuevo al problema?',
    weight: 25,
  },
  {
    code: '02',
    name: 'Uso de IA',
    desc: 'Qué tan profunda y bien implementada está la IA dentro del prototipo.',
    weight: 20,
  },
  {
    code: '03',
    name: 'Viabilidad',
    desc: 'Factibilidad técnica y de negocio de la solución a corto y mediano plazo.',
    weight: 20,
  },
  {
    code: '04',
    name: 'Modelo de negocio / sostenibilidad',
    desc: 'Potencial de transformación real en educación y modelo sostenible en el tiempo.',
    weight: 15,
  },
  {
    code: '05',
    name: 'Calidad del prototipo',
    desc: 'Funcionalidad, presentación y nivel de desarrollo del MVP entregado.',
    weight: 10,
  },
  {
    code: '06',
    name: 'Calidad del Pitch',
    desc: 'Claridad, convicción y presentación ante el jurado en los 8 minutos finales.',
    weight: 10,
  },
];
---

<section id="evaluation" class="section evaluation">
  <div class="container">
    <div class="ev-head" data-reveal>
      <span class="section-tag">Criterios de evaluación</span>
      <h2 class="section-title">
        Cómo el jurado mide <span class="gradient-text">cada prototipo</span>
      </h2>
      <p class="section-subtitle">
        Seis criterios públicos con pesos definidos. Los equipos saben exactamente
        qué se evalúa antes de empezar a construir.
      </p>
    </div>

    <div class="ev-grid">
      {criteria.map((c, i) => (
        <article class="ev-card glass" data-reveal style={`transition-delay: ${i * 70}ms`}>
          <header class="ev-card-head">
            <span class="ev-code mono">{c.code}</span>
            <span class="ev-weight mono">{c.weight}%</span>
          </header>
          <h3 class="ev-name">{c.name}</h3>
          <p class="ev-desc">{c.desc}</p>
          <div class="ev-bar" aria-hidden="true">
            <div class="ev-bar-fill" style={`--w: ${c.weight * 4}%`}></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ev-head {
    max-width: 720px;
    margin-bottom: 40px;
  }

  .ev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .ev-card {
    position: relative;
    padding: 26px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.4s ease;
  }

  .ev-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ev-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 100% 0%, var(--grad-soft), transparent 55%);
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .ev-card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--primary) 55%, var(--border));
    box-shadow: 0 24px 55px -28px color-mix(in srgb, var(--primary) 55%, transparent);
  }

  .ev-card:hover::before {
    transform: scaleX(1);
  }

  .ev-card:hover::after {
    opacity: 1;
  }

  .ev-card-head {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ev-code {
    font-size: 11px;
    color: var(--primary);
    letter-spacing: 0.18em;
    font-weight: 700;
    transition: text-shadow 0.3s ease;
  }

  .ev-card:hover .ev-code {
    text-shadow: 0 0 16px color-mix(in srgb, var(--primary) 80%, transparent);
  }

  .ev-weight {
    font-size: 18px;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.04em;
    display: inline-block;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ev-card:hover .ev-weight {
    transform: scale(1.14);
  }

  .ev-name {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text);
    margin: 4px 0 2px;
  }

  .ev-desc {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.5;
    flex: 1;
  }

  .ev-bar {
    position: relative;
    margin-top: 14px;
    height: 5px;
    border-radius: 999px;
    background: var(--surface-strong);
    overflow: hidden;
  }

  .ev-bar-fill {
    position: relative;
    height: 100%;
    width: 0;
    background: var(--grad);
    border-radius: 999px;
    transition: width 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }

  .ev-card.is-visible .ev-bar-fill {
    width: var(--w);
  }

  .ev-bar-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-100%);
    animation: ev-shine 2.8s ease-in-out infinite 1.2s;
  }

  @keyframes ev-shine {
    0% { transform: translateX(-100%); }
    60%, 100% { transform: translateX(100%); }
  }

  @media (max-width: 1080px) {
    .ev-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 540px) {
    .ev-grid { grid-template-columns: 1fr; }
  }
</style>
