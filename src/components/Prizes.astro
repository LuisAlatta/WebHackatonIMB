---
const finalistsPerks = [
  {
    icon: 'mentor',
    title: '2do Lugar',
    desc: '600 dólares Premio económico · Puesto Part-time en IMB por 3 meses para todos los miembros del equipo · Certificado de Reconocimiento',
  },
  {
    icon: 'learn',
    title: '3er Lugar',
    desc: '300 dólares Premio económico · Capacitación Especializada IMB con docente internacional · Certificado de Reconocimiento',
  },
  {
    icon: 'demo',
    title: 'Mejor Pitch',
    desc: 'Reconocimiento especial del jurado',
  },
  {
    icon: 'cert',
    title: 'Todos los equipos',
    desc: 'Certificado de participación avalado',
  },
];

const winnersPerk = {
  icon: 'briefcase',
  title: '1er Lugar',
  desc: '1200 dólares Capital semilla · Proceso de incubación JAKU · Mentoría especializada · Certificado de Excelencia',
};
---

<section id="prizes" class="section prizes">
  <div class="container">
    <div class="finalists" data-reveal>
      <div class="finalists-head">
        <span class="section-tag">Premios · Recompensas</span>
        <h3 class="finalists-title">El talento y esfuerzo serán recompensados.</h3>
      </div>
      <ul class="finalists-grid">
        <li class="perk perk--winners" data-reveal>
          <span class="perk-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M2 13h20"/></svg>
          </span>
          <div>
            <span class="perk-badge mono">1er Lugar</span>
            <span class="perk-title">{winnersPerk.title}</span>
            <span class="perk-desc">{winnersPerk.desc}</span>
          </div>
        </li>

        {finalistsPerks.map((perk, i) => (
          <li class="perk" data-reveal style={`transition-delay: ${(i + 1) * 90}ms`}>
            <span class="perk-icon" aria-hidden="true">
              {perk.icon === 'cert' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.5 12.5 17 22l-5-3-5 3 1.5-9.5"/></svg>
              )}
              {perk.icon === 'demo' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
              )}
              {perk.icon === 'community' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              )}
              {perk.icon === 'mentor' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              )}
              {perk.icon === 'learn' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              )}
              {perk.icon === 'merch' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/></svg>
              )}
            </span>
            <div>
              <span class="perk-title">{perk.title}</span>
              <span class="perk-desc">{perk.desc}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .finalists {
    border: 1px solid var(--border);
    border-radius: 28px;
    padding: clamp(28px, 4vw, 48px);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--bg-2) 70%, transparent), color-mix(in srgb, var(--bg-1) 80%, transparent));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .finalists-head {
    margin-bottom: 32px;
  }

  .finalists-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 14px;
  }

  .finalists-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .perk {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, box-shadow 0.4s ease;
  }

  .perk:hover {
    border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
    transform: translateY(-4px);
    background: color-mix(in srgb, var(--primary) 6%, var(--surface));
    box-shadow: 0 18px 44px -26px color-mix(in srgb, var(--primary) 55%, transparent);
  }

  .perk-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--primary) 18%, transparent);
    color: var(--primary);
    border: 1px solid color-mix(in srgb, var(--primary) 35%, transparent);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, box-shadow 0.3s ease;
  }

  .perk:hover .perk-icon {
    transform: rotate(-6deg) scale(1.1);
    box-shadow: 0 8px 22px -8px color-mix(in srgb, var(--primary) 70%, transparent);
  }

  .perk > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .perk-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.01em;
  }

  .perk-desc {
    font-size: 13.5px;
    color: var(--text-dim);
    line-height: 1.5;
  }

  /* ---------- Solo ganadores ---------- */
  .perk--winners {
    grid-column: 1 / -1;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--primary) 10%, var(--surface)), color-mix(in srgb, var(--accent) 8%, var(--surface)));
    border-color: color-mix(in srgb, var(--primary) 55%, transparent);
    margin-bottom: 8px;
    animation: prize-glow 3.6s ease-in-out infinite;
  }

  @keyframes prize-glow {
    0%, 100% {
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 22%, transparent),
                  0 20px 60px color-mix(in srgb, var(--primary) 16%, transparent);
    }
    50% {
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 42%, transparent),
                  0 26px 72px color-mix(in srgb, var(--primary) 32%, transparent);
    }
  }

  .perk--winners::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 34%, color-mix(in srgb, var(--primary) 20%, transparent), transparent 66%);
    transform: translateX(-130%);
    pointer-events: none;
    animation: prize-shine 5s ease-in-out infinite;
  }

  @keyframes prize-shine {
    0% { transform: translateX(-130%); }
    55%, 100% { transform: translateX(130%); }
  }

  .perk--winners > * {
    position: relative;
    z-index: 1;
  }

  .perk--winners:hover {
    border-color: color-mix(in srgb, var(--primary) 75%, transparent);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--primary) 16%, var(--surface)), color-mix(in srgb, var(--accent) 12%, var(--surface)));
  }

  .perk--winners .perk-icon {
    background: var(--grad-soft);
    color: var(--primary);
    border-color: color-mix(in srgb, var(--primary) 60%, transparent);
    animation: prize-icon-float 3.2s ease-in-out infinite;
  }

  @keyframes prize-icon-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .perk-badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 45%, transparent);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 6px;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 540px) {
    .finalists-grid { grid-template-columns: 1fr; }
  }
</style>
